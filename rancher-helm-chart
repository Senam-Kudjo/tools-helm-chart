helm install rancher rancher-stable/rancher \
  --namespace cattle-system \
  --set hostname=rancher.local \
  --set bootstrapPassword=admin123 \
  --set replicas=1 \
  --set ingress.enabled=false


kubectl expose deployment rancher -n cattle-system \
  --type=NodePort \
  --port=443 \
  --target-port=443 \
  --name=rancher-nodeport \
  --overrides='{"spec":{"ports":[{"port":443,"targetPort":443,"nodePort":30443}]}}'


kubectl create configmap rancher-proxy-config -n cattle-system \
  --from-literal=nginx.conf="server { listen 80; location / { proxy_pass https://rancher.cattle-system.svc.cluster.local; proxy_ssl_verify off; proxy_set_header Host \$host; proxy_set_header X-Real-IP \$remote_addr; proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for; proxy_set_header X-Forwarded-Proto https; } }"


kubectl create deployment rancher-http-proxy -n cattle-system --image=nginx:latest


kubectl patch deployment rancher-http-proxy -n cattle-system --type=json -p='[
  {"op":"add","path":"/spec/template/spec/volumes","value":[{"name":"config","configMap":{"name":"rancher-proxy-config"}}]},
  {"op":"add","path":"/spec/template/spec/containers/0/volumeMounts","value":[{"name":"config","mountPath":"/etc/nginx/conf.d/default.conf","subPath":"nginx.conf"}]}
]'


kubectl expose deployment rancher-http-proxy -n cattle-system \
  --type=NodePort \
  --port=80 \
  --target-port=80 \
  --overrides='{"spec":{"ports":[{"port":80,"targetPort":80,"nodePort":30080}]}}'


